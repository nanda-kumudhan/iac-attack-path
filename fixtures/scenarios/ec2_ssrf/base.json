{
  "format_version": "1.2",
  "terraform_version": "normalized-static-slice",
  "planned_values": {
    "root_module": {
      "resources": [
        {
          "address": "aws_vpc.main",
          "mode": "managed",
          "type": "aws_vpc",
          "name": "main",
          "values": {
            "id": "vpc-main"
          }
        },
        {
          "address": "aws_subnet.public",
          "mode": "managed",
          "type": "aws_subnet",
