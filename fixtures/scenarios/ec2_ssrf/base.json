              {
                "protocol": "tcp",
                "from_port": 80,
                "to_port": 80,
                "cidr_blocks": [
                  "10.0.0.0/8"
                ]
              }
            ]
          }
        },
        {
          "address": "aws_instance.ubuntu_ec2",
          "mode": "managed",
