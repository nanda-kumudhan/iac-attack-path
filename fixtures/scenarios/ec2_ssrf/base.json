              {
                "cidr_block": "0.0.0.0/0",
                "gateway_id": "igw-main"
              }
            ]
          }
        },
        {
          "address": "aws_route_table_association.public",
          "mode": "managed",
          "type": "aws_route_table_association",
          "name": "public",
          "values": {
