            "arn": "arn:aws:s3:::cg-example-data"
          }
        },
        {
          "address": "aws_iam_policy.ec2_policy",
          "mode": "managed",
          "type": "aws_iam_policy",
          "name": "ec2_policy",
          "values": {
            "arn": "arn:aws:iam::111111111111:policy/ec2-policy",
            "policy": "{\"Statement\": [{\"Effect\": \"Allow\", \"Action\": [\"s3:*\", \"cloudwatch:*\"], \"Resource\": \"*\"}]}"
          }
